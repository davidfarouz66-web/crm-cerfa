generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  role      String   @default("admin")
  status    String   @default("active")
  resetToken       String?
  resetTokenExpiry DateTime?
  tenantId  String   @default("default")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  auditLogs AuditLog[]
}

model Association {
  id               String   @id @default(cuid())
  nom              String
  adresse          String?
  codePostal       String?
  ville            String?
  pays             String?  @default("France")
  siret            String?
  rna              String?
  objetSocial      String?
  qualiteOrganisme String?
  representant     String?
  telephone        String?
  email            String?
  logoUrl          String?
  signatureUrl     String?
  cachetUrl        String?
  cerfaSequence    Int      @default(0)
  // Éligibilité fiscale
  organismeEligibleMecenat    Boolean  @default(false)
  articlesFiscauxAutorises    String?  @default("200")
  typeOrganisme               String?
  dateVerificationEligibilite DateTime?
  commentaireEligibilite      String?
  responsableLegalNom         String?
  responsableLegalFonction    String?
  // RGPD
  dureConservationAnnees      Int      @default(10)
  contactRgpd                 String?
  tenantId         String   @default("default")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Donateur {
  id            String   @id @default(cuid())
  type          String   @default("particulier")
  civilite      String?  @default("M")
  nom           String
  prenom        String?
  raisonSociale String?
  formeJuridique String?
  siretDonateur  String?
  adresse       String?
  codePostal    String?
  ville         String?
  pays          String   @default("France")
  email         String?
  telephone     String?
  notes         String?
  // RGPD
  consentementProspection Boolean  @default(false)
  dateConsentement        DateTime?
  oppositionProspection   Boolean  @default(false)
  notesRgpd               String?
  tenantId      String   @default("default")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  cerfas        Cerfa[]
}

model Cerfa {
  id             String   @id @default(cuid())
  numeroCerfa    String   @unique
  donateur       Donateur @relation(fields: [donateurId], references: [id])
  donateurId     String
  dateDon        DateTime
  montant        Float
  modePaiement   String
  objetDon       String?
  natureDon      String   @default("numeraire")
  formeDon       String   @default("declaration_manuel")
  articleFiscal  String   @default("200")
  dateEmission   DateTime @default(now())
  pdfPath        String?
  sentAt         DateTime?
  status         String   @default("actif")
  motifAnnulation String?
  dateAnnulation  DateTime?
  tenantId       String   @default("default")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Settings {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  user       User?    @relation(fields: [userId], references: [id])
  userId     String?
  action     String
  entityType String
  entityId   String?
  oldValues  String?
  newValues  String?
  createdAt  DateTime @default(now())
}
